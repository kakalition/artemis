<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd agent for the Artemis Telegram bot (macOS).
     Edit the two /ABSOLUTE paths, then:
       cp deploy/com.artemis.bot.plist ~/Library/LaunchAgents/
       launchctl load  ~/Library/LaunchAgents/com.artemis.bot.plist
       launchctl start com.artemis.bot
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.artemis.bot</string>
    <key>ProgramArguments</key>
    <array>
      <string>/Users/CHANGE_ME/Workspaces/Artemis/.venv/bin/artemis</string>
      <string>bot</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/CHANGE_ME/Workspaces/Artemis</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>ARTEMIS_HOME</key>
      <string>/Users/CHANGE_ME/.local/share/artemis</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/artemis-bot.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/artemis-bot.err.log</string>
  </dict>
</plist>
