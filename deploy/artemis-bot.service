# systemd user unit for the Artemis Telegram bot.
#   cp deploy/artemis-bot.service ~/.config/systemd/user/
#   # edit the paths below, then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now artemis-bot
[Unit]
Description=Artemis Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Workspaces/Artemis
EnvironmentFile=%h/Workspaces/Artemis/.env
ExecStart=%h/Workspaces/Artemis/.venv/bin/artemis bot
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
