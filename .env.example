# --- Identity ---------------------------------------------------------------
OWNER_ID=owner
OWNER_NAME=Owner

# --- Model / provider -------------------------------------------------------
# Any OpenAI-compatible endpoint works. For OpenRouter/CommandCode gateways set
# OPENAI_BASE_URL to the gateway root (without a trailing /chat/completions).
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=
MODEL_NAME=openai:gpt-4o-mini
# Transport resilience.
MODEL_TIMEOUT=60
MODEL_RETRIES=2
# Optional per-run usage caps (blank = unlimited).
USAGE_REQUEST_LIMIT=
USAGE_TOTAL_TOKENS_LIMIT=
# Observability (on by default; self-hosted, no account).
#   phoenix  - launch a local Arize Phoenix UI (default; needs the
#              observability-phoenix extra, else falls back to console)
#   console  - print spans to the terminal
#   otlp     - export to your OpenTelemetry backend (Jaeger/Tempo/Langfuse)
#   off      - disable
OBSERVABILITY=phoenix
OTLP_ENDPOINT=
LOG_JSON=false

# --- Imports ----------------------------------------------------------------
# Reject CSV/bank statements larger than this many bytes.
MAX_IMPORT_BYTES=5000000

# --- Storage ----------------------------------------------------------------
# Leave blank to use the local file at ~/.agentkit/artemis/artemis.db.
# For Turso: sqlite+libsql://<db>-<org>.turso.io?secure=true
LIBSQL_URL=
LIBSQL_AUTH_TOKEN=

# --- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Comma- or space-separated chat IDs allowed to talk to the bot.
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Local paths ------------------------------------------------------------
# Data lives under the workspace root at <root>/<AGENT_NAME> (default ~/.agentkit/artemis).
AGENTKIT_HOME=~/.agentkit
# Optional explicit home override (legacy name kept).
# ARTEMIS_HOME=/Users/you/.agentkit/artemis
LOG_LEVEL=INFO
# Agent persona. Default: ./SOUL.md (project root), else $AGENT_HOME/SOUL.md.
SOUL_FILE=

# --- Market data ------------------------------------------------------------
# "manual" (default) or "yfinance" (requires the optional 'prices' extra).
PRICE_SOURCE=manual

# --- External MCP servers (apollo) -----------------------------------------
CHARTING_DIR=~/Workspaces/agent-mcps/apollo-charting
PDF_DIR=~/Workspaces/agent-mcps/apollo-pdf-creator
# If set, connect over HTTP instead of spawning stdio subprocesses.
CHARTING_MCP_URL=
PDF_MCP_URL=

# --- A2A --------------------------------------------------------------------
A2A_PUBLIC_URL=http://127.0.0.1:9000
A2A_CARD_NAME=Artemis
A2A_HOST=127.0.0.1
A2A_PORT=9000
PEERS_FILE=

# --- MCP server -------------------------------------------------------------
MCP_HOST=127.0.0.1
MCP_PORT=8765
# The MCP server exposes the full agent via the ask_artemis tool. Bulk/destructive
# tools (CSV import, delete) require approval; with no interactive approver over
# MCP they are DENIED unless you opt in here (dangerous).
MCP_AUTO_APPROVE=false

# --- Web UI (served by `artemis up`; loopback only) -------------------------
WEBUI_ENABLED=true
WEBUI_HOST=127.0.0.1
WEBUI_PORT=8787
